{
  "name": "curelink",
  "private": true,
  "description": "Smart Medicine Availability and OCR-Based Pharmacy Coordination System",
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "test": "npm test --prefix server && npm test --prefix client",
    "lint": "npm run lint --prefix server && npm run lint --prefix client",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "ansi-regex": "^6.2.2",
    "ansi-styles": "^6.2.3",
    "chalk": "^5.6.2",
    "cliui": "^9.0.1",
    "emoji-regex": "^10.6.0",
    "escalade": "^3.2.0",
    "get-caller-file": "^2.0.5",
    "get-east-asian-width": "^1.6.0",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.8.4",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.2.0",
    "supports-color": "^10.2.2",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "wrap-ansi": "^9.0.2",
    "y18n": "^5.0.8",
    "yargs": "^18.0.0",
    "yargs-parser": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malith06/curelink.git"
  },
  "keywords": [],
